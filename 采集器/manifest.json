{
  "manifest_version": 3,
  "name": "Refellow · 参伴 · 页面采集器",
  "version": "0.5.2",
  "minimum_chrome_version": "116",
  "description": "框选或整屏截图、当前网页区域录制；采集结果保存到登录账户的个人网站空间。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabCapture",
    "offscreen"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "参伴：显示悬浮采集器（授权当前页）"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.siteinspire.com/*", "https://*.siteinspire.com/*", "https://onepagelove.com/*", "https://*.onepagelove.com/*",
        "https://www.awwwards.com/*", "https://*.awwwards.com/*", "https://recent.design/*", "https://*.recent.design/*",
        "https://land-book.com/*", "https://*.land-book.com/*", "https://lapa.ninja/*", "https://*.lapa.ninja/*",
        "https://httpster.net/*", "https://*.httpster.net/*", "https://mobbin.com/*", "https://*.mobbin.com/*",
        "https://refero.design/*", "https://*.refero.design/*", "https://saasframe.io/*", "https://*.saasframe.io/*",
        "https://60fps.design/*", "https://*.60fps.design/*", "https://reactbits.dev/*", "https://*.reactbits.dev/*",
        "https://threeui.com/*", "https://*.threeui.com/*", "https://21st.dev/*", "https://*.21st.dev/*",
        "https://ui.shadcn.com/*", "https://*.ui.shadcn.com/*", "https://inspoai.io/*", "https://*.inspoai.io/*",
        "https://fontsinuse.com/*", "https://*.fontsinuse.com/*", "https://typewolf.com/*", "https://*.typewolf.com/*"
      ],
      "js": ["floating.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "host_permissions": [
    "https://lingganji.pages.dev/*",
    "https://*.lingganji.pages.dev/*"
  ]
}
