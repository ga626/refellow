{
  "manifest_version": 3,
  "name": "Refellow · 参伴 · 页面采集器",
  "version": "0.5.0",
  "minimum_chrome_version": "116",
  "description": "框选或整屏截图、当前网页区域录制；采集结果保存到登录账户的个人网站空间。",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabCapture",
    "offscreen"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "参伴：显示悬浮采集器（授权当前页）"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "host_permissions": [
    "https://lingganji.pages.dev/*",
    "https://*.lingganji.pages.dev/*"
  ]
}
